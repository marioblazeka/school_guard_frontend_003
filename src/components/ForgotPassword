<template>
  <div class="auth-container">
    <h2>Zaboravljena lozinka</h2>
    <p class="info-text">Unesite email kako bismo vam poslali poveznicu za ponovno postavljanje lozinke.</p>
    <form @submit.prevent="handleReset" class="auth-form">
      <div class="form-group">
        <label>Email adresa</label>
        <input type="email" v-model="email" required placeholder="email@example.com" />
      </div>
      <p v-if="errorMessage" class="error-msg">{{ errorMessage }}</p>
      <p v-if="successMessage" class="success-msg">{{ successMessage }}</p>
      <button type="submit" :disabled="loading" class="btn-auth">Pošalji poveznicu</button>
    </form>
  </div>
</template>

<script>
import { auth } from '@/firebase';
import { sendPasswordResetEmail } from 'firebase/auth';

export default {
  name: 'ForgotPasswordView',
  data() {
    return {
      email: '',
      errorMessage: '',
      successMessage: '',
      loading: false
    };
  },
  methods: {
    async handleReset() {
      this.loading = true;
      this.errorMessage = '';
      this.successMessage = '';
      try {
        await sendPasswordResetEmail(auth, this.email);
        this.successMessage = 'Poveznica je poslana! Provjerite vašu dolaznu poštu (i Spam mapu).';
      } catch (error) {
        this.errorMessage = 'Došlo je do greške. Provjerite jeste li ispravno upisali email.';
      } finally {
        this.loading = false;
      }
    }
  }
}

.auth-container {
  max-width: 400px;
  margin: 50px auto;
  padding: 30px;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}
.auth-form {
  display: flex;
  flex-direction: column;
  text-align: left;
}
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  color: #2c3e50;
}
.form-group input {
  width: 100%;
  padding: 12px;
  border: 1px solid #ced4da;
  border-radius: 6px;
  box-sizing: border-box;
}
.btn-auth {
  background-color: #42b983;
  color: white;
  border: none;
  padding: 12px;
  font-weight: bold;
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.2s;
}
.btn-auth:hover {
  background-color: #3aa876;
}
.btn-auth:disabled {
  background-color: #a8dbc3;
  cursor: not-allowed;
}
.error-msg { color: #e74c3c; font-size: 14px; margin-top: -10px; margin-bottom: 15px; }
.success-msg { color: #2ecc71; font-size: 14px; margin-top: -10px; margin-bottom: 15px; }
.info-text { color: #7f8c8d; font-size: 14px; margin-bottom: 20px; }
</script>